{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.mjs",
    "build:prod": "vite build && node scripts/generate-sitemap.mjs",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "postbuild": "shx cp _redirects dist/ && shx cp .htaccess dist/"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/material": "^6.0.0",
    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.2.6",
    "aos": "^2.3.4",
    "axios": "^1.7.2",
    "commonninja-react": "^1.1.12",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "emoji-picker-react": "^4.13.2",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lodash": "^4.17.23",
    "lucide-react": "^0.469.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1",
    "react-leaflet": "^4.2.1",
    "react-multi-carousel": "^2.8.5",
    "react-range": "^1.8.14",
    "react-rating": "^2.0.5",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.24.0",
    "react-spinners": "^0.14.1",
    "socket.io-client": "^4.7.5",
    "stripe": "^16.1.0",
    "swiper": "^11.1.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.49",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "shx": "^0.4.0",
    "tailwindcss": "^3.4.15",
    "terser": "^5.46.0",
    "vite": "^5.3.1"
  }
}
