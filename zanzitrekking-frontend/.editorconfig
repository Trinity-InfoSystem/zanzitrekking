# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JavaScript, JSX, JSON files
[*.{js,jsx,json}]
indent_size = 2

# TypeScript files (if added in future)
[*.{ts,tsx}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# CSS, SCSS files
[*.{css,scss}]
indent_size = 2

# Configuration files
[*.{config.js,config.cjs}]
indent_size = 2
