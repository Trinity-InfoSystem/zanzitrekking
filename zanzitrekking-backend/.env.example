# Database Configuration
DB_URL=mongodb://localhost:27017/zanzitrekking

# Comma separated list of CORS allowed origins
CORS_ORIGINS=

# JWT Secrets
SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here

# Server Configuration
PORT=5000
NODE_ENV=production

# Redis socket path (priority)
REDIS_SOCKET=

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WeTravel API Configuration
WETRAVEL_API_KEY=your_wetravel_api_key
WETRAVEL_USE_DEMO=false
WETRAVEL_WEBHOOK_SECRET=your_webhook_secret

# Safari Office API Configuration
SAFARI_TOKEN=your_safari_token

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email
EMAIL_PASSWORD=your_password
EMAIL_FROM=noreply@example.com

# Frontend URL
FRONTEND_URL=https://booking.zanzisafaris.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id

# Contact Form Configuration
CONTACT_RECEIVER_EMAIL=contact@example.com

# WeTravel Configuration
WETRAVEL_API_KEY=
WETRAVEL_USE_DEMO=
WETRAVEL_WEBHOOK_SECRET=

# Redis Configuration
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# OR
REDIS_SOCKET=

# Prerender Service Url
PRERENDER_SERVICE_URL=
